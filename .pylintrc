# Линт для Ghidra-скриптов репозитория.
# Pyghidra_helper.py исполняется в Jython внутри Ghidra: println/ask*/goTo/
# currentProgram и т.п. — встроенные глобалы среды, а ghidra.*/java.* импорты
# разрешаются только там. Для CPython-линтера это ложные срабатывания.
[MASTER]
ignored-modules=ghidra, java

[MESSAGES CONTROL]
disable=all
enable=E0100,E0101,E0102,E0110,E0111,E0112,E0113,E0114,E0115,E0117,E0202,E0203,E0235,E0236,E0237,E0238,E0239,E0241,E0301,E0302,E0303,E0304,E0305,E0306,E0402,E0601,E0603,E0604,E0605,E0611,E0633,E0701,E0702,E0703,E1101,E1102,E1111,E1120,E1121,E1123,E1124,E1125,E1126,E1127,E1128,E1129,E1130,E1131,E1132,E1133,E1134,E1135,E1136,E1137,E1138,E1139,E1141,E1300,E1301,E1302,E1303,E1305,E1306,E1700,E1701

[DESIGN]
max-line-length=120
