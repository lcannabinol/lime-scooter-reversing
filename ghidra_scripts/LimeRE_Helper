def action_trace_callers(addr=None):
    if addr is None:
        addr = askAddress(u"Callers", u"Адрес внутри целевой функции:")
    addr = to_addr(addr)
    f = get_function_at_or_containing(addr)
    if f is None:
        println(_fmt("[-] Нет функции @ {}", addr))
        return

    println(_fmt("=== Callers: {} @ {} ===", f.getName(), f.getEntryPoint()))
    refs = getReferencesTo(f.getEntryPoint())
    n = 0
    seen = {}
    for r in refs:
        rt = r.getReferenceType()
        if rt.isCall() or rt.isJump():
            from_addr = r.getFromAddress()
            key = str(from_addr)
            if key in seen:
                continue
            seen[key] = True
            caller_f = get_function_at_or_containing(from_addr)
            name = caller_f.getName() if caller_f is not None else u"<нет функции>"
            println(_fmt("  {}  →  {}   ({})", from_addr, name, rt))
            n += 1
    if n == 0:
        println(u"  (ссылок call/jump нет)")
    else:
        println(_fmt("Всего: {}", n))


def action_trace_callees(addr=None):
    if addr is None:
        addr = askAddress(u"Callees", u"Адрес внутри целевой функции:")
    addr = to_addr(addr)
    f = get_function_at_or_containing(addr)
    if f is None:
        println(_fmt("[-] Нет функции @ {}", addr))
        return

    println(_fmt("=== Callees: {} @ {} ===", f.getName(), f.getEntryPoint()))
    insns = currentProgram.getListing().getInstructions(f.getBody(), True)
    n = 0
    seen = {}
    while insns.hasNext():
        insn = insns.next()
        for r in insn.getReferencesFrom():
            if r.getReferenceType().isCall():
                to_a = r.getToAddress()
                key = str(to_a)
                if key in seen:
                    continue
                seen[key] = True
                target_f = getFunctionAt(to_a)
                name = target_f.getName() if target_f is not None else str(to_a)
                println(_fmt("  {}  вызывает  {}  ({})", insn.getAddress(), name, to_a))
                n += 1
    if n == 0:
        println(u"  (вызовов нет)")
    else:
        println(_fmt("Всего: {}", n))


def action_xrefs_to_address(addr=None):
    if addr is None:
        addr = askAddress(u"XREF to", u"Целевой адрес:")
    addr = to_addr(addr)
    refs = getReferencesTo(addr)
    println(_fmt("=== Ссылки НА {} ===", addr))
    count = 0
    for r in refs:
        from_a = r.getFromAddress()
        f = get_function_at_or_containing(from_a)
        fname = f.getName() if f is not None else "-"
        println(_fmt("  {}  ({})  <-  {}   [{}]", from_a, fname, r.getReferenceType(), r.getSource()))
        count += 1
    println(_fmt("Всего: {}", count))


def action_xrefs_in_range():
    start = askAddress(u"Начало диапазона", u"Start:")
    end = askAddress(u"Конец диапазона", u"End (включительно):")
    start = to_addr(start)
    end = to_addr(end)

    size = end.subtract(start) + 1
    if size > 0x10000:
        if not askYesNo(u"Большой диапазон",
                        _fmt(u"Диапазон {} байт — может быть долго. Продолжить?", size)):
            return

    println(_fmt("=== Ссылки в {} – {} ===", start, end))
    count = 0
    refmgr = currentProgram.getReferenceManager()
    aset = currentProgram.getAddressFactory().getAddressSet(start, end)
    it = refmgr.getReferenceDestinationIterator(aset, True)
    while it.hasNext():
        dest = it.next()
        for r in getReferencesTo(dest):
            from_a = r.getFromAddress()
            f = get_function_at_or_containing(from_a)
            fname = f.getName() if f is not None else "-"
            println(_fmt("  {}  →  {}   ({} / {})", from_a, dest, fname, r.getReferenceType()))
            count += 1
            if count >= 500:
                println(u"... обрезано на 500")
                println(_fmt("Всего (обрез.): {}", count))
                return
    println(_fmt("Всего: {}", count))


def action_find_constant_xrefs():
    dlg = ConstPickDialog()
    DockingWindowManager.showDialog(dlg)
    if dlg.was_cancelled():
        return
    val = dlg.selected
    if val is None:
        val_str = askString(u"Своё значение", u"Константа (hex или dec):", "0x258")
        if val_str is None:
            return
        val_str = val_str.strip().lower()
        val = int(val_str, 16) if val_str.startswith("0x") else int(val_str)

    println(_fmt("=== Поиск immediate 0x{:X} ===", val))
    listing = currentProgram.getListing()
    count = 0
    insns = listing.getInstructions(True)
    while insns.hasNext() and count < 300:
        insn = insns.next()
        found = False
        for i in range(insn.getNumOperands()):
            objs = insn.getOpObjects(i)
            if objs is None:
                continue
            for o in objs:
                try:
                    if hasattr(o, "getValue") and int(o.getValue()) == val:
                        f = get_function_at_or_containing(insn.getAddress())
                        fname = f.getName() if f is not None else "-"
                        println(_fmt("  {}  [{}]  {}", insn.getAddress(), fname, insn))
                        count += 1
                        found = True
                        break
                except Exception:
                    pass
            if found:
                break
    println(_fmt("Найдено инструкций: {}", count))


def action_rename_at_address():
    addr = askAddress(u"Переименовать", u"Адрес:")
    name = askString(u"Новое имя", u"Имя:", "new_name")
    if name is None or name == "":
        return
    a = to_addr(addr)
    f = get_function_at_or_containing(a)
    if f is not None and f.getEntryPoint().equals(a):
        safe_rename_function(a, name)
    else:
        safe_create_label(a, name)
        if f is not None:
            if askYesNo(u"Ещё и функцию?",
                        _fmt(u"Переименовать и содержащую функцию {}?", f.getName())):
                safe_rename_function(f.getEntryPoint(), name)


