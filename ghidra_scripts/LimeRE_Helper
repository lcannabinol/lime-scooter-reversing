                     [u"Plate (над блоком)", u"EOL (в конце строки)"],
                     u"Plate (над блоком)")
    text = askString(u"Текст", u"Текст комментария:")
    if text is None or text == "":
        return
    if str(kind).startswith("Plate"):
        add_plate_comment(addr, text)
    else:
        add_eol_comment(addr, text)


def action_dump_function_info(addr=None):
    if addr is None:
        addr = askAddress(u"Инфо о функции", u"Адрес внутри функции:")
    addr = to_addr(addr)
    f = get_function_at_or_containing(addr)
    if f is None:
        println(_fmt("[-] Нет функции @ {}", addr))
        return

    println("=" * 60)
    println(_fmt("Функция : {}", f.getName()))
    println(_fmt("Entry   : {}", f.getEntryPoint()))
    println(_fmt("Размер  : {} адресов", f.getBody().getNumAddresses()))
    try:
        println(_fmt("Calling : {}", f.getCallingConventionName()))
    except Exception:
        pass
    try:
        println(_fmt("Signature: {}", f.getSignature()))
    except Exception:
        pass
    println("--- Callers ---")
    action_trace_callers(f.getEntryPoint())
    println("--- Callees ---")
    action_trace_callees(f.getEntryPoint())
    println("=" * 60)


def action_bookmark_key_sites():
    for addr, desc in KEY_LOCATIONS.items():
        a = to_addr(addr)
        createBookmark(a, "LimeRE", desc)
        println(_fmt("[+] Bookmark @ {}  {}", a, desc))
    println(u"Готово.  Window → Bookmarks")


def action_goto_known():
    items = []
    for a, n in sorted(KNOWN_FUNCTIONS.items()):
        items.append(("F  0x%08X  %s" % (a, n), a))
    for a, n in sorted(KNOWN_RAM.items()):
        items.append(("R  0x%08X  %s" % (a, n), a))
    for a, n in sorted(KEY_LOCATIONS.items()):
        items.append(("K  0x%08X  %s" % (a, n), a))

    dlg = SymbolPickDialog(items, u"Перейти к символу")
    DockingWindowManager.showDialog(dlg)
    if dlg.was_cancelled() or dlg.selected is None:
        return
    addr = to_addr(dlg.selected)
    goTo(addr)
    println(_fmt("Переход → {}", addr))


