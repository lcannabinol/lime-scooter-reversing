ACTION_MAP = {
    "apply_names": action_apply_all_known_names,
    "trace_callers": action_trace_callers,
    "trace_callees": action_trace_callees,
    "xrefs_to": action_xrefs_to_address,
    "xrefs_range": action_xrefs_in_range,
    "find_const": action_find_constant_xrefs,
    "rename": action_rename_at_address,
    "comment": action_add_comment,
    "func_info": action_dump_function_info,
    "bookmarks": action_bookmark_key_sites,
    "goto": action_goto_known,
}


def run():
    while True:
        action_id = show_main_menu()
        if action_id is None or action_id == "exit":
            println(u"Выход.")
            return
        fn = ACTION_MAP.get(action_id)
        if fn is None:
            println(_fmt("Неизвестное действие: {}", action_id))
            continue
        try:
            fn()
        except CancelledException:
            println(u"Отменено.")
        except Exception as e:
            println(_fmt("[!] Ошибка: {}", e))
            try:
                import traceback
                traceback.print_exc()
            except Exception:
                pass


run()
