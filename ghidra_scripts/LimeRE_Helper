class MenuDialog(DialogComponentProvider):

    def __init__(self):
        # title, modal, status, buttons, canRunTasks
        super(MenuDialog, self).__init__(u"Lime RE Helper — меню", True, True, True, False)

        self.selected_id = None
        self._cancelled = True

        self.setResizable(True)
        self.setRememberSize(True)
        self.setRememberLocation(True)
        self.setPreferredSize(720, 420)
        try:
            self.setMinimumSize(Dimension(500, 300))
        except Exception:
            pass

        self.addWorkPanel(self._build_panel())
        self.addOKButton()
        self.addCancelButton()
        self.setOkButtonText(u"Выполнить")
        self.setCancelButtonText(u"Закрыть")
        self.setDefaultButton(self.okButton)
        self.setStatusText(u"Выбери действие и нажми «Выполнить» (или двойной клик / Enter).")

    def _build_panel(self):
        model = DefaultListModel()
        self._ids = []
        self._descs = []
        for aid, title, desc in MENU_ACTIONS:
            model.addElement(title)
            self._ids.append(aid)
            self._descs.append(desc)

        self.list = JList(model)
        self.list.setSelectionMode(ListSelectionModel.SINGLE_SELECTION)
        self.list.setSelectedIndex(0)
        self.list.setVisibleRowCount(12)
        try:
            self.list.setFont(Font("Dialog", Font.PLAIN, 13))
        except Exception:
            pass

        scroll_list = JScrollPane(self.list)
        scroll_list.setBorder(BorderFactory.createTitledBorder(u"Действия"))

        self.desc_area = JTextArea()
        self.desc_area.setEditable(False)
        self.desc_area.setLineWrap(True)
        self.desc_area.setWrapStyleWord(True)
        self.desc_area.setText(self._descs[0])
        try:
            self.desc_area.setFont(Font("Dialog", Font.PLAIN, 13))
        except Exception:
            pass
        scroll_desc = JScrollPane(self.desc_area)
        scroll_desc.setBorder(BorderFactory.createTitledBorder(u"Описание"))

        outer = self

        class Sel(ListSelectionListener):
            def valueChanged(self, event):
                if event.getValueIsAdjusting():
                    return
                idx = outer.list.getSelectedIndex()
                if idx >= 0:
                    outer.desc_area.setText(outer._descs[idx])

        self.list.addListSelectionListener(Sel())

        class Dbl(MouseAdapter):
            def mouseClicked(self, event):
                if event.getClickCount() == 2:
                    outer.okCallback()

        self.list.addMouseListener(Dbl())

        class KeyH(KeyAdapter):
            def keyPressed(self, event):
                if event.getKeyCode() == KeyEvent.VK_ENTER:
                    outer.okCallback()

        self.list.addKeyListener(KeyH())

        split = JSplitPane(JSplitPane.HORIZONTAL_SPLIT, scroll_list, scroll_desc)
        split.setResizeWeight(0.45)
        split.setDividerLocation(320)

        root = JPanel(BorderLayout(8, 8))
        root.setBorder(BorderFactory.createEmptyBorder(8, 8, 8, 8))
        root.add(split, BorderLayout.CENTER)

        hint = JLabel(u"Двойной клик или Enter — выполнить. Край окна можно тянуть.")
        hint.setHorizontalAlignment(SwingConstants.LEFT)
        root.add(hint, BorderLayout.SOUTH)
        return root

    def okCallback(self):
        idx = self.list.getSelectedIndex()
        if idx < 0:
            self.setStatusText(u"Сначала выбери пункт в списке.")
            return
        self.selected_id = self._ids[idx]
        self._cancelled = False
        self.close()

    def cancelCallback(self):
        self.selected_id = None
        self._cancelled = True
        self.close()

    def was_cancelled(self):
        return self._cancelled


def show_main_menu():
    dlg = MenuDialog()
    DockingWindowManager.showDialog(dlg)
    if dlg.was_cancelled():
        return None
    return dlg.selected_id


